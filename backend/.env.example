# =====================================================================
# TicketNest backend configuration
# Copy this file to `.env` (same folder) and fill in your own values.
# NEVER commit the real .env file. Everything here is optional locally
# except SECRET_KEY.
# =====================================================================

# --- Core -------------------------------------------------------------
ENVIRONMENT=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# Empty = SQLite file in backend/data (local development).
# Production: postgresql://USER:PASSWORD@HOST:5432/ticketnest?sslmode=require
DATABASE_URL=

# --- Web --------------------------------------------------------------
# The website (also serves the Mini App at /tg and the admin at /admin)
SITE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Public https URL of this API in production (the Telegram webhook needs https)
API_PUBLIC_URL=http://localhost:8000
RATE_LIMIT_ENABLED=true

# --- First admin (hosts without a shell). Remove after the first sign-in. ---
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Telegram: the TicketNest bot (from @BotFather) -------------------------
# Used for admin alerts + commands, customer order updates, Telegram login and the Mini App.
TELEGRAM_BOT_TOKEN=
# Group that receives business alerts (send /groupid in it to see the ID, e.g. -1001234567890)
TELEGRAM_ADMIN_GROUP_ID=
# Telegram USER IDs allowed to run admin commands / press admin buttons (send /myid to the bot)
TELEGRAM_ADMIN_ID=
# Default support username (live value is edited in Admin > Settings > Telegram)
TELEGRAM_SUPPORT_USERNAME=
# Mini App link from BotFather, e.g. https://t.me/TicketNestBot/app
TELEGRAM_MINI_APP_URL=

# --- ABA PayWay payment confirmation (same setup as IceQ Sole) --------------
# Group where @PayWayByABA_bot posts your payments
TELEGRAM_PAYMENT_GROUP_ID=
PAYWAY_BOT_USERNAME=PayWayByABA_bot
# Listener = a Telegram USER account that is a member of the payment group.
# Values from my.telegram.org + `python scripts/telegram_login.py`. Secret!
TG_LISTENER_API_ID=
TG_LISTENER_API_HASH=
TG_LISTENER_SESSION=
# Optional, strongest check: Bakong Open API token (https://api-bakong.nbc.gov.kh)
BAKONG_API_TOKEN=

# --- Email --------------------------------------------------------------
# Brevo (free 300/day, HTTPS - works on Render free). EMAIL_FROM must be a verified sender.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=TicketNest
# Or SMTP (e.g. Gmail with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Google sign-in (OAuth client ID, Web application) ----------------------
GOOGLE_CLIENT_ID=

# --- Files --------------------------------------------------------------
# local = backend/storage (development) | r2 = Cloudflare R2
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=8
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# public bucket (posters) + its public URL; private bucket (ticket proofs, deliveries) - NOT public
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=

TIMEZONE=Asia/Phnom_Penh
